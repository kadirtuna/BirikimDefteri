<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Uygulama ile widget, kurum fiyatlarını bu ortak Anahtar Zinciri grubunda paylaşır
	     (ücretsiz Apple hesabı App Group'a izin vermiyor). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.kadirtuna.birikimdefteri.shared</string>
	</array>
</dict>
</plist>
